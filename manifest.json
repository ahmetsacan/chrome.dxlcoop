{
  "manifest_version": 3,
  "name": "dxlcoop",
  "version": "1.0.0",
  "description": "Improves Drexel co-op job viewing by displaying job details inline in job cart and search results. Adds text filtering and download functionality.",
  "permissions": ["storage"],
  "host_permissions": ["https://banner.drexel.edu/*"],
  "content_scripts": [{
    "matches": [
      "https://banner.drexel.edu/duprod/hwczksjsd.P_StudentJobCart*",
      "https://banner.drexel.edu/duprod/hwczksjsc.P_StudentJobSearchValidate*",
      "https://banner.drexel.edu/duprod/hwczkglbp.P_AlterOverridePaging*"
    ],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
